# The third-party code that webcpp's libraries and their tests use, each a
# submodule of its own under libs/, pinned at a commit and keeping its own
# licence, declared here as /webcpp/third_party//<target>, whose usage
# requirements give a program what it needs. A target whose submodule is not
# checked out stops the build that needs it, naming the command that checks
# it out; a build that needs none never looks.
import errors ;
import path ;
import regex ;
import webcpp ;

project /webcpp/third_party ;

# The JSON Schema Test Suite (MIT), json-schema-org/JSON-Schema-Test-Suite:
# test data, never compiled into a program. A test that names
# json-schema-test-suite reads it at run time from the directory
# WEBCPP_TEST_JSON_SCHEMA_TEST_SUITE names, with forward slashes, the whole
# define quoted for a checkout whose path holds a space, and runs again when
# one of its files changes; under wasmtime the directory is given to it
# (webcpp.data). The files are a usage requirement, so b2 gives them to every
# action of the test: a changed file compiles and links it again too, not
# only runs it. That costs a rebuild; a narrower dependency must still run
# the test again on every file.
path-constant JSON_SCHEMA_TEST_SUITE : libs/JSON-Schema-Test-Suite ;
.suite = [ regex.replace $(JSON_SCHEMA_TEST_SUITE) "\\\\" "/" ] ;
.suite-files = [ glob-tree-ex libs/JSON-Schema-Test-Suite/tests
    libs/JSON-Schema-Test-Suite/remotes libs/JSON-Schema-Test-Suite/output-tests
    libs/JSON-Schema-Test-Suite/annotations : *.json ] ;

rule suite-checked-out ( properties * )
{
    if ! [ path.exists [ path.native $(JSON_SCHEMA_TEST_SUITE)/tests/draft2020-12 ] ]
    {
        errors.user-error "third_party/libs/JSON-Schema-Test-Suite is not checked out: it"
            "holds no tests/draft2020-12. Check it out with `git submodule update --init"
            "third_party/libs/JSON-Schema-Test-Suite`." ;
    }
}

alias json-schema-test-suite : : <conditional>@suite-checked-out : :
    <define>"\"WEBCPP_TEST_JSON_SCHEMA_TEST_SUITE=\\\"$(.suite)\\\"\""
    [ webcpp.data $(JSON_SCHEMA_TEST_SUITE) ]
    <dependency>$(.suite-files) ;

explicit json-schema-test-suite ;

# nativejson-benchmark (MIT), miloyip/nativejson-benchmark: Milo Yip's JSON
# benchmark, whose three files, data/canada.json, data/citm_catalog.json and
# data/twitter.json, document's benchmarks read (libs/document/bench); test
# data, never compiled into a program, and its own submodules never checked
# out. A program that names nativejson-benchmark reads the files at run time
# from the directory WEBCPP_TEST_NATIVEJSON_BENCHMARK names, the checkout's,
# as json-schema-test-suite gives its own, wasmtime given it too
# (webcpp.data), and runs again when one of them changes.
path-constant NATIVEJSON_BENCHMARK : libs/nativejson-benchmark ;
.nativejson = [ regex.replace $(NATIVEJSON_BENCHMARK) "\\\\" "/" ] ;
.nativejson-files = [ glob libs/nativejson-benchmark/data/*.json ] ;

rule nativejson-checked-out ( properties * )
{
    if ! [ path.exists [ path.native $(NATIVEJSON_BENCHMARK)/data/canada.json ] ]
    {
        errors.user-error "third_party/libs/nativejson-benchmark is not checked out: it"
            "holds no data/canada.json. Check it out with `git submodule update --init"
            "third_party/libs/nativejson-benchmark`." ;
    }
}

alias nativejson-benchmark : : <conditional>@nativejson-checked-out : :
    <define>"\"WEBCPP_TEST_NATIVEJSON_BENCHMARK=\\\"$(.nativejson)\\\"\""
    [ webcpp.data $(NATIVEJSON_BENCHMARK) ]
    <dependency>$(.nativejson-files) ;

explicit nativejson-benchmark ;
