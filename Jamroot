# webcpp, the superproject: it finds the installed Boost and checks its
# version, sets what every library shares, registers each library of libs/
# as /webcpp/<name>, declares the aggregates test, example, doc and
# install, and lists the targets and the lanes the libraries declare
# (declared-targets, declared-lanes).
import boost ;
import errors ;
import feature ;
import modules ;
import notfile ;
import numbers ;
import os ;
import package ;
import path ;
import type ;

# The rules the libraries' test and example Jamfiles declare their programs
# with, which import it as webcpp.
import tools/webcpp ;

# A shell with CPATH (Homebrew sets it) puts its headers before the
# configured Boost, and the compiler would use them without a word.
for local variable in CPATH CPLUS_INCLUDE_PATH C_INCLUDE_PATH
{
    if [ os.environ $(variable) ]
    {
        errors.user-error "$(variable) is set; unset it, or the compiler reads"
            "headers from it before the configured Boost" ;
    }
}

# wasm32-wasip2 is no system b2 knows. It is registered after the toolsets
# of user-config.jam have loaded gcc.jam, which computes as it loads the
# systems that get Unix link options (--start-group, -Bstatic, rpath), which
# wasm-component-ld rejects.
if ! wasi in [ feature.values <target-os> ]
{
    feature.extend target-os : wasi ;
}
type.set-generated-target-suffix EXE : <target-os>wasi : wasm ;

# /boost is the `using boost` of user-config.jam, else the Boost tree that
# BOOST_ROOT names, else Boost on the compiler's default include path (b2's
# contrib/boost.jam).
boost.use-project ;

# The directory that holds boost/version.hpp for /boost//headers, as
# boost.use-project chose it: the <include> of `using boost`, else its
# <root>, else BOOST_ROOT, both a Boost tree. Nothing when Boost is left to
# the compiler's default include path. It is read from the boost module,
# where use-project keeps it: the /boost project of a tree is loaded only
# after this Jamroot.
rule boost-include ( )
{
    local version = [ modules.peek boost : .initialized ] ;
    local options = [ modules.peek boost : .boost.$(version) ] ;
    local directory = [ $(options).get <include> ] ;
    directory ?= [ $(options).get <root> ] ;
    directory ?= [ modules.peek : BOOST_ROOT ] ;
    return $(directory) ;
}

.boost-include = [ boost-include ] ;

# The line of the file header that defines BOOST_VERSION, as every Boost
# writes it: #define BOOST_VERSION 109200. b2 runs a SHELL command with
# cmd.exe on Windows, where findstr does what grep does elsewhere.
local rule version-line ( header )
{
    if [ os.name ] = NT
    {
        local native = [ path.native [ path.make $(header) ] ] ;
        return [ SHELL "findstr /B /C:\"#define BOOST_VERSION \" \"$(native)\"" ] ;
    }
    return [ SHELL "grep \"^#define BOOST_VERSION \" \"$(header)\"" ] ;
}

# The version the boost/version.hpp under directory defines, as its
# BOOST_VERSION and as a name: 108000 1.80.0. Nothing when there is no such
# file, or when its version cannot be read.
rule boost-version ( directory )
{
    local header = $(directory)/boost/version.hpp ;
    if [ path.exists $(header) ]
    {
        local line = [ version-line $(header) ] ;
        local digits = [ MATCH "BOOST_VERSION +(([0-9]+)([0-9][0-9][0-9])([0-9][0-9]))" : $(line) ] ;
        if $(digits)
        {
            local minor = [ MATCH "^0*([0-9]+)$" : $(digits[3]) ] ;
            local patch = [ MATCH "^0*([0-9]+)$" : $(digits[4]) ] ;
            return $(digits[1]) $(digits[2]).$(minor).$(patch) ;
        }
    }
}

# Where package managers install Boost, in the order the advice of
# boost-unusable prefers them.
.boost-prefixes = /opt/homebrew/opt/boost /usr/local/opt/boost /opt/local /usr/local /usr ;

# The first of .boost-prefixes that holds Boost 1.92 or newer, and that
# Boost's version: /opt/homebrew/opt/boost 1.92.0. Nothing when none does.
rule boost-installed ( )
{
    for local prefix in $(.boost-prefixes)
    {
        local version = [ boost-version $(prefix)/include ] ;
        if $(version) && ! [ numbers.less $(version[1]) 109200 ]
        {
            return $(prefix) $(version[2]) ;
        }
    }
}

# The failure of the configuration check: it stops the build, saying what
# was found and the `using boost` line that fixes it, for the user-config.jam
# that b2 read.
rule boost-unusable ( properties * )
{
    local status ;
    if ! $(.boost-include)
    {
        status = "Boost 1.92 or newer was not found: no `using boost` names its"
            "location, and none is on the compiler's default include path" ;
    }
    else if ! [ path.exists $(.boost-include)/boost/version.hpp ]
    {
        status = "Boost 1.92 or newer was not found:"
            "$(.boost-include)/boost/version.hpp does not exist" ;
    }
    else if [ numbers.less $(.boost-found[1]) 109200 ]
    {
        status = "Boost 1.92 or newer is required, and Boost $(.boost-found[2])"
            "was found in $(.boost-include)" ;
    }
    else
    {
        errors.user-error "Boost $(.boost-found[2]) was found in"
            "$(.boost-include), but a program that includes it does not"
            "compile with these properties; bin/config.log says why" ;
    }
    local config = [ modules.binding user-config ] ;
    config ?= user-config.jam ;
    local installed = [ boost-installed ] ;
    local prefix = $(installed[1]) ;
    local advice = "Boost $(installed[2]) is installed in $(prefix): configure"
        "it in $(config) with this line, in place of any other `using boost`:" ;
    if ! $(prefix)
    {
        prefix = /path/to/boost ;
        advice = "Install Boost 1.92 or newer, and configure it in $(config)"
            "with this line, where /path/to/boost is where it is installed, in"
            "place of any other `using boost`:" ;
    }
    errors.user-error $(status)
        : $(advice)
        : "    using boost : 1.92 : <include>$(prefix)/include <library>$(prefix)/lib ;" ;
}

# The configuration check: tools/test/boost_version.cpp compiles only against
# Boost 1.92 or newer. b2 caches the answer in bin/project-cache.jam by the
# check's name and the target's properties, so the name holds Boost's
# directory and the version found there: another Boost is checked again, and
# so is another version in the same directory (Homebrew points opt/boost at
# the keg of each version).
.boost-check-name = "Boost 1.92 or newer" ;
if $(.boost-include)
{
    .boost-found = [ boost-version $(.boost-include) ] ;
    .boost-check-name = "$(.boost-check-name) in $(.boost-include)" ;
}
if $(.boost-found)
{
    .boost-check-name = "$(.boost-check-name) ($(.boost-found[2]))" ;
}
.boost-check = [ check-target-builds /webcpp//boost_version $(.boost-check-name)
    : : <conditional>@boost-unusable ] ;

# Some targets leave the check out of their requirements: the check's own
# target, which evaluates the project's requirements too and would wait on
# itself; declared-targets and declared-lanes, which read only Jamfiles, for
# a CI job that installs no Boost; and the targets that compile nothing, such
# as the documentation's and the oracle's Node packages. The feature marks
# them; free and incidental, it changes neither a target's properties nor its
# path.
feature.feature webcpp-boost-check : : free incidental ;

# The check's answer is cached by the version it read, so a Boost whose
# version cannot be read stops the build even when it compiles: a version
# changed in place would reuse the answer. It also proves on every system
# that the version is read there, cmd.exe's findstr included.
rule boost-check ( properties * )
{
    if ! <webcpp-boost-check>off in $(properties)
    {
        if $(.boost-include) && ! $(.boost-found)
            && [ path.exists $(.boost-include)/boost/version.hpp ]
        {
            errors.user-error "Boost 1.92 or newer is required, and the version of the"
                "Boost in $(.boost-include) cannot be read: its boost/version.hpp has no"
                "line `#define BOOST_VERSION <number>`" ;
        }
        return $(.boost-check) ;
    }
}

project /webcpp
  : requirements
      <cxxstd>20
      <warnings>extra
      <warnings-as-errors>on
      <implicit-dependency>/boost//headers
      <library>/boost//headers
      # Boost's headers are system ones, so that their warnings are not ours,
      # and Boost's directory keeps its place, searched before the compiler's
      # own. GCC searches a -isystem directory before its own, and takes a
      # directory given both ways for a system one. Clang searches a -I
      # directory before its own, and Apple's searches /usr/local/include
      # before every -isystem one, so clang and emcc keep the -I and mark the
      # headers that <boost/...> names. Quoted, as b2 quotes its own -I, so
      # that a path that holds a space builds: the shell removes the quotes,
      # and so does cl from the response file b2 writes the options to. The
      # prefix is quoted too, since b2 drops a slash that ends a property.
      <toolset>gcc:<cxxflags>"-isystem\"$(.boost-include)\""
      <toolset>clang:<cxxflags>"--system-header-prefix=\"boost/\""
      <toolset>emscripten:<cxxflags>"--system-header-prefix=\"boost/\""
      <toolset>msvc:<cxxflags>"\"/external:I$(.boost-include)\""
      <toolset>msvc:<cxxflags>"/external:W0"
      # Boost.Container's auto-link (reached through Boost.JSON) would ask
      # for a compiled library on MSVC.
      <toolset>msvc:<define>BOOST_ALL_NO_LIB
      <toolset>msvc,<exception-handling>off:<define>_HAS_EXCEPTIONS=0
      <target-os>windows:<define>_WIN32_WINNT=0x0A00
      # The toolsets clang-wasip2 and clang-wasip3 (user-config.jam) build
      # for wasm32-wasip2 and wasm32-wasip3, which have no shared libraries.
      <toolset>clang-wasip2:<target-os>wasi
      <toolset>clang-wasip3:<target-os>wasi
      <target-os>wasi:<link>static
      # A library that declares wasip2 builds there without exceptions, a
      # portability policy: some wasm hosts lack exception handling. Boost
      # then calls boost::throw_exception in place of a throw: webcpp.jam
      # links its definition, tools/throw_exception.cpp, into such a program.
      <toolset>clang-wasip2:<exception-handling>off
      <toolset>clang-wasip2:<define>BOOST_NO_EXCEPTIONS
      # One that declares wasip3 may use exceptions, encoded as the standard
      # exception handling of WebAssembly (exnref): the clang of wasi-sdk 34
      # emits the legacy encoding by default, which wasmtime 47 refuses to
      # run ("legacy_exceptions feature required"). The runtime is libunwind.
      <toolset>clang-wasip3:<cxxflags>"-fwasm-exceptions -mllvm -wasm-use-legacy-eh=false"
      <toolset>clang-wasip3:<linkflags>"-fwasm-exceptions -lunwind"
      <conditional>@boost-check
  : default-build <variant>debug
  : build-dir bin
  ;

# The check compiles this again each time it runs: the object's path is the
# same for every Boost, and installed headers keep their package's dates, so
# another Boost is often older than the object and would leave it up to date.
obj boost_version : tools/test/boost_version.cpp
  : <webcpp-boost-check>off ;
always boost_version ;

# The handler of a program built without exceptions, which webcpp.jam links
# as /webcpp//throw_exception. Compiled once per variant: the program's
# <exception-handling>off reaches it, and Boost.Config then defines
# BOOST_NO_EXCEPTIONS, which its definitions need.
obj throw_exception : tools/throw_exception.cpp ;

# Boost.JSON's definitions, tools/boost_json.cpp, for a header-only build on
# every target: a library that needs Boost.JSON puts
# <library>/webcpp//boost_json in its main target's usage requirements.
# Static, and built once per variant: the program's own features, such as
# <exception-handling>off, reach it, as they reach the handler.
lib boost_json : tools/boost_json.cpp : <link>static ;

# The projects in the directories that pattern matches, each named
# ./<directory>: b2 takes a directory for the project in it, and a bare doc
# would name the alias doc itself.
rule projects ( pattern )
{
    local directories = [ glob $(pattern) ] ;
    return ./$(directories) ;
}

# Headers are installed under <prefix>/include, --prefix=/usr/local by
# default, or under --includedir.
.package-paths = [ package.paths webcpp ] ;
.includedir = [ $(.package-paths).includedir ] ;

path-constant WEBCPP_ROOT : . ;

# The documentation toolchain's own targets, tools/doc/Jamfile.
use-project /webcpp/doc-tools : tools/doc ;

# The files under directory, at any depth, without its directories, which
# glob-tree-ex returns too, and without hidden files such as .DS_Store.
rule files-under ( directory )
{
    local files ;
    for local entry in [ glob-tree-ex $(directory) : * : .* ]
    {
        if [ CHECK_IF_FILE $(WEBCPP_ROOT)/$(entry) ]
        {
            files += $(entry) ;
        }
    }
    return $(files) ;
}

# A library is a directory of libs/ with a build.jam (a submodule not
# checked out has none), registered as /webcpp/<name>. Its test, example and
# doc directories join the aggregates, and every file of its
# include/webcpp/** the installation, which keeps their tree.
for local build in [ glob libs/*/build.jam ]
{
    local library = $(build:D) ;
    local name = $(library:B) ;
    use-project /webcpp/$(name) : $(library) ;
    build-project $(library) ;
    .test += [ projects $(library)/test ] ;
    .example += [ projects $(library)/example ] ;
    .doc += [ projects $(library)/doc ] ;
    install install-$(name)
      : [ files-under $(library)/include/webcpp ]
      : <location>$(.includedir) <install-source-root>$(library)/include ;
    .install += install-$(name) ;
}

alias test : $(.test) ;
alias example : $(.example) ;
alias doc : [ projects doc ] $(.doc) ;
alias install : $(.install) ;

# The test and example directories of every library, absolute, in b2's form.
rule library-directories ( )
{
    local root = [ path.make $(WEBCPP_ROOT) ] ;
    local directories ;
    for local directory in $(.test) $(.example)
    {
        directories += [ path.root [ path.make $(directory) ] $(root) ] ;
    }
    return $(directories) ;
}

# `b2 declared-targets` prints each pair "<library> <target>" that a program
# of a library's test or example Jamfiles declares, one per line, sorted: the
# lanes CI runs for each library. With -d0, b2 prints nothing else.
rule declared-targets ( targets * : sources * : properties * )
{
    for local pair in [ webcpp.declared [ library-directories ] ]
    {
        ECHO $(pair) ;
    }
}
notfile declared-targets : @declared-targets : : <webcpp-boost-check>off ;

# `b2 declared-lanes` prints each line "<library> <lane> <directory>" that a
# library's test or example Jamfiles declare with webcpp.lane, sorted: a
# library's own lanes, such as its oracle's, which CI runs as
# `b2 -a <directory>//<lane>`. It reads only Jamfiles too, and needs neither
# Boost nor Node.
rule declared-lanes ( targets * : sources * : properties * )
{
    for local lane in [ webcpp.lanes [ library-directories ] ]
    {
        ECHO $(lane) ;
    }
}
notfile declared-lanes : @declared-lanes : : <webcpp-boost-check>off ;

# A lane builds and runs one library's tests and examples for one target,
# from scratch, and writes what b2 built and ran, which
# tools/report/report.py turns into the test matrix:
#
#     b2 -a --dump-tests --out-xml=<lane>.xml toolset=<toolset> \
#         libs/<library>/test libs/<library>/example
#     python3 tools/report/report.py --lane <lane>=<lane>.xml ... --out <dir>
#
# A wasip2 or wasip3 lane adds testing.launcher=wasmtime. --dump-tests lists
# every test, those the lane skips included. With --out-xml, b2 exits 0 even
# when a test fails: the report's exit status is the verdict.

explicit boost_version throw_exception boost_json test example doc install $(.install)
    declared-targets declared-lanes ;
