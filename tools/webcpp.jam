#
# The rules a library's test and example Jamfiles declare their programs
# with, in place of b2's run, exe and compile:
#
#     import webcpp ;
#     webcpp.targets native wasip2 wasip3 ;
#     webcpp.run name : sources + : requirements * : targets * ;
#     webcpp.run-fail name : sources + : requirements * : targets * ;
#     webcpp.compile name : sources + : requirements * : targets * ;
#     webcpp.compile-fail name : sources + : requirements * : targets * ;
#     webcpp.compile-diagnostic name : sources + : requirements * : targets * ;
#     webcpp.boost-test name : sources + : requirements * ;
#     webcpp.example source : requirements * : targets * ;
#     webcpp.headers-alone library : include-root : only * : requirements *
#       : targets * ;
#
# the rule with which any test or example Jamfile of a library declares one
# of its own lanes, which `b2 declared-lanes` lists:
#
#     webcpp.lane name : targets + ;
#
# the rules of the documentation, tools/doc/doc.jam's, with which a library's
# doc Jamfile declares its page and its reference, and the superproject's
# doc/Jamfile its index page:
#
#     webcpp.doc library : page ;
#     webcpp.reference library : requirements * : also-checked * ;
#     webcpp.index page ;
#
# and the rules of the oracle, tools/oracle/oracle.jam's, with which a
# library's test/oracle/Jamfile runs its original over its twins and cases:
#
#     webcpp.original word + ;
#     webcpp.twins examples : twins : suffix : extra-words * ;
#     webcpp.cases name : script : cases : expected ;
#
# and the rules of a WebAssembly component, tools/component/component.jam's,
# with which a library's build.jam declares the C bindings of a world, and
# its test and example Jamfiles an HTTP component that wasmtime serves:
#
#     webcpp.wit-bindings name : world-file : world : rename : version
#       : wit-bindgen-argument * ;
#     webcpp.serve source : requirements * : targets * ;
#     webcpp.serve-script name : script : stem : targets * ;
#
# A target is what a program is built for: emscripten (b2's toolset
# emscripten), wasip2 and wasip3 (the clang toolsets of user-config.jam
# whose versions are wasip2 and wasip3), and native (any other toolset). A
# program is built for its own targets, else for those of its Jamfile's
# webcpp.targets, else for native only. For any other target, b2 skips it
# without a word.
import alias ;
import errors ;
import feature ;
import make ;
import modules ;
import numbers ;
import os ;
import path ;
import project ;
import regex ;
import sequence ;
import set ;
import testing ;

.known = native emscripten wasip2 wasip3 ;

# A program's targets, which filter reads. Free, so that a program's
# targets play no part in its build directory.
feature.feature webcpp-targets : : free incidental ;

# The header a translation unit of headers-alone includes, as
# webcpp/<library>/<name>.hpp.
feature.feature webcpp-include : : free incidental ;

# What links tools/throw_exception.cpp, the handler Boost calls in place of
# a throw, into a program built without exceptions: every program on
# wasip2, whose toolset the Jamroot builds without them, and any other whose
# user asks b2 for exception-handling=off. webcpp builds no variant of its
# own without exceptions, nor any without RTTI.
.handler = <exception-handling>off:<source>/webcpp//throw_exception ;

if [ os.name ] = NT { .python = python ; } else { .python = python3 ; }

# This directory, absolute, and the superproject's, its parent: the root
# every path this module and webcpp-oracle record is relative to.
.tools = [ path.parent [ path.root [ path.make [ modules.binding $(__name__) ] ] [ path.pwd ] ] ] ;
.root = [ path.parent $(.tools) ] ;

# The example runner, beside this file, as an absolute native path: the
# action that runs it starts in the directory b2 was started in.
.runner = [ path.native [ path.join $(.tools) example/run_example.py ] ] ;

# The Boost.Test framework of webcpp.boost-test, beside this file, as a plain file of /webcpp,
# this file's own project, by its location relative to the superproject: a suite's obj gets it
# the way throw_exception and boost_json below are got, by a project and a path, never by an
# absolute path or one joined to the suite's own location, which a resolved symlink in root
# (TMPDIR on macOS) would then disagree with.
local .tools-relative = [ path.relative-to $(.root) $(.tools) ] ;
.framework = /webcpp//$(.tools-relative)/boost_test_runner.cpp ;

# The arguments a Boost.Test suite of webcpp.boost-test is run with.
.boost-test-arguments = --log_level=error --color_output=no ;

# The documentation's rules, loaded as the module webcpp-doc: b2 has a
# module named doc of its own, the one of --help, which an import of
# tools/doc/doc would find in its place.
modules.load webcpp-doc : doc.jam : [ path.native [ path.join $(.tools) doc ] ] ;
import webcpp-doc ;

# The oracle's rules, loaded as the module webcpp-oracle, as the
# documentation's are.
modules.load webcpp-oracle : oracle.jam : [ path.native [ path.join $(.tools) oracle ] ] ;
import webcpp-oracle ;

# The rules of a WebAssembly component, loaded as the module
# webcpp-component, as the documentation's are.
modules.load webcpp-component : component.jam
  : [ path.native [ path.join $(.tools) component ] ] ;
import webcpp-component ;

.nl = "\n" ;

# The target the toolset of properties builds for.
local rule target-of ( properties * )
{
    local toolset = [ feature.get-values <toolset> : $(properties) ] ;
    if $(toolset) = emscripten
    {
        return emscripten ;
    }
    if $(toolset) = clang
    {
        # A switch, since `in` holds for an empty list: a clang without a
        # version is native.
        switch [ feature.get-values <toolset-clang:version> : $(properties) ]
        {
            case wasip2 : return wasip2 ;
            case wasip3 : return wasip3 ;
        }
    }
    return native ;
}

# The conditional requirement of every program: <build>no when the toolset
# builds for a target that is not among the program's. It reads only
# <toolset> and its version, which the build request sets. A condition on
# <target-os>, which the Jamroot derives from the toolset, would keep b2's
# evaluation of conditional requirements from settling: <build>no replaces
# every other conditional result, <target-os>wasi among them (measured in
# xstate-cpp).
rule filter ( properties * )
{
    if ! [ target-of $(properties) ] in [ feature.get-values <webcpp-targets> : $(properties) ]
    {
        return <build>no ;
    }
}

# Fails, naming context, when any of targets is not a known one.
local rule check ( context : targets * )
{
    for local target in $(targets)
    {
        if ! $(target) in $(.known)
        {
            errors.user-error "$(context): $(target) is not a target; the targets are"
                "$(.known:J= )" ;
        }
    }
}

# The project module of the Jamfile being loaded.
local rule jamfile ( )
{
    local current = [ project.current ] ;
    return [ $(current).project-module ] ;
}

# Where the Jamfile being loaded is: its project; its directory, absolute in
# b2's form; that directory relative to the superproject; the Jamfile
# itself, relative to the superproject; and the superproject's directory.
local rule where ( )
{
    local current = [ project.current ] ;
    local jamfile = [ $(current).project-module ] ;
    local location = [ path.root [ project.attribute $(jamfile) location ] [ path.pwd ] ] ;
    local file = [ path.root [ path.make [ modules.binding $(jamfile) ] ] [ path.pwd ] ] ;
    return $(current) $(location) [ path.relative-to $(.root) $(location) ]
        [ path.relative-to $(.root) $(file) ] $(.root) ;
}

# The library of the Jamfile being loaded: the directory of libs/ that holds
# it. A Jamfile outside libs/ is named by its directory, relative to the
# superproject.
local rule library-of ( )
{
    local found = [ where ] ;
    local library = [ MATCH "^libs/([^/]+)" : $(found[3]) ] ;
    return $(library:E=$(found[3])) ;
}

# Declares the targets of every program its Jamfile declares after it
# without targets of its own.
rule targets ( targets + )
{
    local jamfile = [ jamfile ] ;
    check webcpp.targets : $(targets) ;
    if $(.programs.$(jamfile))
    {
        errors.user-error "webcpp.targets must come before the first program of its Jamfile" ;
    }
    if $(.targets.$(jamfile))
    {
        errors.user-error "webcpp.targets is called twice in the same Jamfile" ;
    }
    .targets.$(jamfile) = $(targets) ;
}

# The requirements that build programs of kind, named names, only for
# targets, else for their Jamfile's, else for native. Each pair <library>
# <target> is recorded for declared, and each program as "<kind> <name>
# <target>..." for programs: kind is the rule that declares it, run,
# run-fail, compile, compile-fail, compile-diagnostic, boost-test, example,
# headers-alone or serve.
local rule program ( kind : names + : targets * )
{
    local jamfile = [ jamfile ] ;
    check "a program's targets" : $(targets) ;
    targets ?= $(.targets.$(jamfile)) ;
    targets ?= native ;
    .programs.$(jamfile) = true ;
    local library = [ library-of ] ;
    .declared += "$(library) $(targets)" ;
    .recorded.$(library) += "$(kind) $(names) $(targets:J= )" ;
    # Qualified by its module, so that it resolves whatever names the
    # Jamfile imported this module's rules under.
    return <webcpp-targets>$(targets) <conditional>@webcpp%filter ;
}

# A test that passes when its program, built from sources, exits with 0.
rule run ( name : sources + : requirements * : targets * )
{
    testing.run $(sources) : : : $(requirements) [ program run : $(name) : $(targets) ]
        $(.handler) : $(name) ;
}

# A Boost.Test suite, built from sources and the header-only framework of
# tools/boost_test_runner.cpp, which passes when every case does. It is built
# and run natively only, whatever its Jamfile's webcpp.targets says. The
# framework is one object of each suite, which names the module
# BOOST_TEST_MODULE=name with - as _ (a hyphen in a macro's replacement would
# read as a subtraction), and is compiled with exceptions on whatever the
# build asks for: built without them, a failed BOOST_TEST_REQUIRE of
# Boost.Test 1.92 never ends the run, and GCC rejects the unguarded try of
# unit_test_main.ipp. --log_level=error makes a failure print its case and
# its check, and --color_output=no keeps out of b2's output and the report's
# pages the terminal's escape sequences, which Boost.Test writes even to a
# file.
rule boost-test ( name : sources + : requirements * )
{
    local only = [ program boost-test : $(name) : native ] ;
    local identifier = [ regex.replace $(name) "-" "_" ] ;
    local framework = <define>BOOST_TEST_MODULE=$(identifier) <exception-handling>on ;
    local current = [ project.current ] ;
    obj $(name)-framework : $(.framework) : $(requirements) $(framework) $(only) ;
    $(current).mark-target-as-explicit $(name)-framework ;
    testing.run $(sources) $(name)-framework : $(.boost-test-arguments)
        : : $(requirements) $(only) $(.handler) : $(name) ;
}

# A test that passes when its program, built from sources, exits with a
# status other than 0.
rule run-fail ( name : sources + : requirements * : targets * )
{
    testing.run-fail $(sources) : : : $(requirements) [ program run-fail : $(name) : $(targets) ]
        $(.handler) : $(name) ;
}

# A test that passes when sources compile, which builds no program.
rule compile ( name : sources + : requirements * : targets * )
{
    testing.compile $(sources) : $(requirements) [ program compile : $(name) : $(targets) ]
        : $(name) ;
}

# A test that passes when sources do not compile.
rule compile-fail ( name : sources + : requirements * : targets * )
{
    testing.compile-fail $(sources) : $(requirements)
        [ program compile-fail : $(name) : $(targets) ] : $(name) ;
}

# A test that passes when sources stop with the errors they state, in
# clang's -verify comments: `// expected-error@<file>:* {{<message>}}` for
# an error of a header they include, `// expected-error@+1 {{<message>}}` for
# one of the next line. clang's -verify makes the compile succeed only when
# every stated error appears; an error that is not stated, and a note, are
# ignored (-verify-ignore-unexpected=error,note), so that a header's
# #error may be followed by what the rest of the header then fails on. A
# compile-fail test passes on any error, the wrong one included; this one
# only on the one it states. -verify is clang's: on a toolset other than
# b2's clang (native clang, clang-wasip2, clang-wasip3), the test is
# skipped, as a program is for a target it does not declare, rather than
# refused, which would turn red every lane of gcc or msvc for a declaration
# that holds; the report shows it there as not built.
rule compile-diagnostic ( name : sources + : requirements * : targets * )
{
    testing.compile $(sources)
      : $(requirements) <cxxflags>"-Xclang -verify -Xclang -verify-ignore-unexpected=error,note"
        <conditional>@webcpp%clang-only [ program compile-diagnostic : $(name) : $(targets) ]
      : $(name) ;
}

# The conditional requirement of compile-diagnostic: <build>no on a toolset
# other than clang, read from <toolset> alone.
rule clang-only ( properties * )
{
    if [ feature.get-values <toolset> : $(properties) ] != clang
    {
        return <build>no ;
    }
}

# An example: the program built from source, run (through testing.launcher
# for a wasm build) with the <stem>.input beside source as its standard
# input, or an empty one when there is none, and its standard output
# compared with the <stem>.expected beside source, by
# tools/example/run_example.py. The target <stem>.output, which holds that
# output, exists only when the two are equal.
rule example ( source : requirements * : targets * )
{
    local name = $(source:B) ;
    local only = [ program example : $(name) : $(targets) ] ;
    exe $(name) : $(source) : $(requirements) $(only) $(.handler) ;
    local found = [ where ] ;
    local input ;
    if [ path.glob $(found[2]) : $(source:S=.input) ]
    {
        input = $(source:S=.input) ;
    }
    # The program's main target can generate more than the executable, which
    # it lists first: MSVC's debug link adds the .pdb after the .exe. So the
    # action reads the program as the first source and the expected output
    # as the last, never as the second, and run-and-compare finds the input
    # by its suffix. The input is a source of the output, so that editing it
    # runs the example again.
    make $(name).output : $(name) $(input) $(source:S=.expected) : @webcpp%run-and-compare
        : $(requirements) $(only) ;
    # testing.launcher is a free feature: it plays no part in the target's
    # build directory, so a .output left over from one launcher reads as up
    # to date under another and the comparison is silently skipped. Always
    # running it again closes that gap.
    local current = [ project.current ] ;
    $(current).mark-target-as-always $(name).output ;
}

rule run-and-compare ( targets * : sources * : properties * )
{
    PYTHON on $(targets) = $(.python) ;
    RUNNER on $(targets) = $(.runner) ;
    # A word made only of a reference to an empty variable disappears whole,
    # quotes included, so a native build (no testing.launcher) would turn
    # `--launcher "$(LAUNCHER)"` into a bare `--launcher`. LAUNCHER_ARGS is
    # instead empty, or the two words `--launcher <value>` together. The
    # value is quoted, so that a launcher whose path holds a space reaches
    # the runner as one argument.
    local launcher = [ feature.get-values <testing.launcher> : $(properties) ] ;
    if $(launcher)
    {
        LAUNCHER_ARGS on $(targets) = --launcher \"$(launcher)\" ;
    }
    else
    {
        LAUNCHER_ARGS on $(targets) = ;
    }
    # The example's input, the source whose suffix is .input, or nothing.
    # The action binds it to its path, and its word `--input="$(INPUT)"`,
    # which holds a reference to it, disappears whole when it is empty.
    local input ;
    for local source in $(sources)
    {
        if $(source:S) = .input
        {
            input = $(source) ;
        }
    }
    INPUT on $(targets) = $(input) ;
}

actions run-and-compare bind INPUT
{
    "$(PYTHON)" "$(RUNNER)" $(LAUNCHER_ARGS) --input="$(INPUT)" --expected "$(>[-1])" --output "$(<)" -- "$(>[1])"
}

# A test per public header of library, each a translation unit that only
# includes it, as <webcpp/...>, and compiles: a header that leans on an
# include it does not make itself fails here, naming it. The headers are
# webcpp/<library>.hpp and every .hpp under webcpp/<library>/, in
# include-root; a translation unit is compiled against the library's main
# target, /webcpp/<library>//<library>, and named alone-<path>, with the
# header's path under webcpp/ written with dashes: alone-xactor-scheduler
# for webcpp/xactor/scheduler.hpp.
#
# only restricts the call to the public headers that match one of its globs,
# each relative to <include-root>/webcpp/ (wasi/http/response.hpp, wasi/*.hpp),
# and a glob that matches none is an error naming it; without only, the call
# takes every public header. requirements are added to each translation unit,
# such as the bindings and the macro a header that builds only for WASI
# needs, and targets replace the Jamfile's for them. A library may call it
# several times, in one Jamfile or several, each for headers of its own: a
# header that two calls take is an error naming it and both Jamfiles. A
# header no call takes is found by tools/lint/compile_commands.py, which
# needs a translation unit of each.
rule headers-alone ( library : include-root : only * : requirements * : targets * )
{
    local current = [ project.current ] ;
    local found = [ where ] ;
    local root = [ path.make $(include-root) ] ;
    local headers =
        [ project.glob-internal-ex $(current) : $(root)/webcpp : $(library).hpp : : glob ]
        [ project.glob-internal-ex $(current) : $(root)/webcpp/$(library) : *.hpp : : glob-tree ] ;
    if ! $(headers)
    {
        errors.user-error "webcpp.headers-alone: $(include-root) holds neither"
            "webcpp/$(library).hpp nor a header under webcpp/$(library)/" ;
    }
    if $(only)
    {
        local taken ;
        for local glob in $(only)
        {
            local matched = [ set.intersection $(headers) : [ project.glob-internal-ex $(current)
                : $(root)/webcpp : $(glob) : : glob ] ] ;
            if ! $(matched)
            {
                errors.user-error "webcpp.headers-alone $(library): $(glob) matches no public"
                    "header under $(include-root)/webcpp/, webcpp/$(library).hpp or a header"
                    "under webcpp/$(library)/" ;
            }
            taken += $(matched) ;
        }
        headers = [ sequence.unique $(taken) ] ;
    }
    local included ;
    local names ;
    for local header in $(headers)
    {
        local path = [ path.relative-to $(root) $(header) ] ;
        if $(.alone.$(library).$(path))
        {
            errors.user-error "webcpp.headers-alone $(library): $(path) is taken by two calls, in"
                "$(.alone.$(library).$(path)) and in $(found[4]); a header compiles alone once" ;
        }
        .alone.$(library).$(path) = $(found[4]) ;
        local stem = [ MATCH "^webcpp/(.*)[.]hpp$" : $(path) ] ;
        local dashed = [ regex.replace $(stem) "/" "-" ] ;
        included += $(path) ;
        names += alone-$(dashed) ;
    }
    local only-targets = [ program headers-alone : $(names) : $(targets) ] ;
    for local index in [ numbers.range 1 [ sequence.length $(names) ] ]
    {
        local name = $(names[$(index)]) ;
        make $(name).cpp : : @webcpp%write-include : <webcpp-include>$(included[$(index)]) ;
        $(current).mark-target-as-explicit $(name).cpp ;
        testing.compile $(name).cpp : <library>/webcpp/$(library)//$(library) $(requirements)
            $(only-targets) : $(name) ;
    }
}

rule write-include ( targets * : sources * : properties * )
{
    HEADER on $(targets) = [ feature.get-values <webcpp-include> : $(properties) ] ;
}

# Writes the file through b2 itself, which works under every shell.
actions write-include
{
    @($(STDOUT):E=#include <$(HEADER)>$(.nl)) > "$(<)"
}

# The pairs "<library> <target>" that the programs of the Jamfiles under
# directories (absolute, in b2's form) declare, at any depth, sorted and
# unique. It loads those Jamfiles, which a build loads only once it reaches
# them.
rule declared ( directories * )
{
    load-jamfiles $(directories) ;
    return [ sequence.unique $(.declared) ] ;
}

# Loads the Jamfiles under directories (absolute, in b2's form), at any
# depth, which a build loads only once it reaches them.
local rule load-jamfiles ( directories * )
{
    local names = [ modules.peek project : JAMFILE ] ;
    for local jamfile in [ path.glob-tree $(directories) : $(names) ]
    {
        project.load $(jamfile:D) ;
    }
}

# webcpp.lane <name> : <target> + ; one of a library's own lanes, such as
# its oracle's: the explicit alias <name> over targets, recorded as
# "<library> <name> <directory>" for lanes. Only a Jamfile under the
# library's test or example directory, which lanes loads, may declare one.
rule lane ( name : targets + )
{
    local found = [ where ] ;
    local library = [ MATCH "^libs/([^/]+)/(test|example)(/.*)?$" : $(found[3]) ] ;
    if ! $(library)
    {
        errors.user-error "webcpp.lane is declared in $(found[4]), which is not a test or an"
            "example Jamfile of a library: only one under libs/<library>/test or"
            "libs/<library>/example declares a lane, so that b2 declared-lanes finds it" ;
    }
    alias $(name) : $(targets) ;
    $(found[1]).mark-target-as-explicit $(name) ;
    .lanes += "$(library[1]) $(name) $(found[3])" ;
}

# The lines "<library> <name> <directory>" of the lanes that the Jamfiles
# under directories (absolute, in b2's form) declare, at any depth, sorted.
rule lanes ( directories * )
{
    load-jamfiles $(directories) ;
    return [ sequence.unique $(.lanes) ] ;
}

# The test and example directories of library, absolute, in b2's form.
local rule directories-of ( library )
{
    return $(.root)/libs/$(library)/test $(.root)/libs/$(library)/example ;
}

# The programs that the test and example Jamfiles of library declare, each
# "<kind> <name> <target>..." as program records it, which
# tools/doc/counts.py counts for the library's page. It loads those
# Jamfiles.
rule programs-of ( library )
{
    load-jamfiles [ directories-of $(library) ] ;
    return $(.recorded.$(library)) ;
}

# What the oracle of library declares with webcpp.twins: its examples and
# twins directories, absolute and as the system writes them, and the
# twins' suffix; nothing when it declares none. It loads the library's test
# and example Jamfiles, the oracle's among them, as declared-lanes does.
rule twins-of ( library )
{
    load-jamfiles [ directories-of $(library) ] ;
    return [ webcpp-oracle.twins-of $(library) ] ;
}

# A library's page, libs/<library>/doc/html/index.html, from page and the
# sections it includes, with the library's reference (tools/doc/doc.jam).
rule doc ( library : page )
{
    webcpp-doc.doc $(library) : $(page) ;
}

# The target reference of a library's doc project, its API reference from
# MrDocs, strict, read with the library's target and requirements, its Doc
# Comments also checked with also-checked, the requirements of the other
# branch of headers that branch by target (tools/doc/doc.jam).
rule reference ( library : requirements * : also-checked * )
{
    webcpp-doc.reference $(library) : $(requirements) : $(also-checked) ;
}

# The superproject's index page, doc/html/index.html, which lists every
# library (tools/doc/doc.jam).
rule index ( page )
{
    webcpp-doc.index $(page) ;
}

# How a program of the original's language runs, and the target node-modules
# (tools/oracle/oracle.jam). Each oracle rule is told where its Jamfile is.
rule original ( words + )
{
    webcpp-oracle.original [ where ] : $(words) ;
}

# The target twins, which runs every twin of examples on the original and
# compares what it prints (tools/oracle/oracle.jam).
rule twins ( examples : twins : suffix : extra * )
{
    webcpp-oracle.twins [ where ] : $(examples) : $(twins) : $(suffix) : $(extra) ;
}

# The target cases-<name>, which runs script on the original over cases and
# compares what it writes with expected (tools/oracle/oracle.jam).
rule cases ( name : script : cases : expected )
{
    webcpp-oracle.cases [ where ] : $(name) : $(script) : $(cases) : $(expected) ;
}

# The C bindings that wit-bindgen generates for the world of world-file,
# for the WASI version version, p2 or p3: the target name, which adds them
# on that version's toolset only, and the explicit target name-headers,
# which adds their directory on any toolset
# (tools/component/component.jam).
rule wit-bindings ( name : world-file : world : rename : version : arguments * )
{
    webcpp-component.wit-bindings [ where ] : $(name) : $(world-file) : $(world) : $(rename)
        : $(version) : $(arguments) ;
}

# An HTTP component built from source, served by wasmtime and checked, a test
# of b2's: the program <stem>-component and the test <stem>, which passes
# when the transcript of the answers to <stem>.requests equals <stem>.expected
# (tools/component/component.jam). It is built for its own targets, which
# may be only wasip2 and wasip3, else for those of its Jamfile that are.
rule serve ( source : requirements * : targets * )
{
    local found = [ where ] ;
    local jamfile = [ jamfile ] ;
    local served = [ webcpp-component.served-targets $(found) : "webcpp.serve $(source)"
        : $(targets) : $(.targets.$(jamfile)) ] ;
    webcpp-component.serve $(found) : $(source) : $(requirements) $(.handler)
        : [ program serve : $(source:B) : $(served) ] ;
}

# An HTTP component that a shell script builds, served by wasmtime and checked
# as webcpp.serve's is: the test name, which passes when the transcript of the
# answers to <stem>.requests equals <stem>.expected
# (tools/component/component.jam).
rule serve-script ( name : script : stem : targets * )
{
    local found = [ where ] ;
    local jamfile = [ jamfile ] ;
    local served = [ webcpp-component.served-targets $(found) : "webcpp.serve-script $(name)"
        : $(targets) : $(.targets.$(jamfile)) ] ;
    webcpp-component.serve-script $(found) : $(name) : $(script) : $(stem)
        : [ program serve : $(name) : $(served) ] ;
}
