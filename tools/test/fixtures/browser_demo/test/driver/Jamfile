import webcpp ;

webcpp.targets native emscripten ;

# drive.mjs runs the program, with node on emscripten, and passes when it
# prints ready: a test that only a script of node's can drive, in its own
# lane on both targets.
webcpp.original node ;
webcpp.drive driven : driven.cpp : : drive.mjs : --program ;
webcpp.lane driver : driven : native emscripten ;
