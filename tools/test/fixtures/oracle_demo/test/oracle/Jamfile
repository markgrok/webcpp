# The oracle of oracle_demo: its original is JavaScript itself, run by Node.

import webcpp ;

webcpp.original node --conditions=development ;
webcpp.twins ../../example : twins : .mjs ;
webcpp.cases squares : cases.mjs : ../fixtures/cases : ../fixtures/expected ;
webcpp.lane oracle : twins cases-squares ;
