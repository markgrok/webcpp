project : requirements <library>/webcpp/component_demo//component_demo ;

import webcpp ;

webcpp.targets native wasip2 wasip3 ;

# On wasip2 and wasip3, a translation unit that includes the world's
# bindings compiles, and the bindings' own C is compiled with it.
webcpp.compile bindings : bindings.cpp : <library>/webcpp/component_demo//demo-bindings
  : wasip2 wasip3 ;
# Natively, the same bindings add nothing, and ask for no wit-bindgen.
webcpp.run native_alone : native_alone.cpp : <library>/webcpp/component_demo//demo-bindings
  : native ;
# On wasip2 and wasip3, an HTTP component served by wasmtime, whose answers
# are checked; natively it is not built.
webcpp.serve answers.cpp : <library>/webcpp/component_demo//demo-bindings ;
