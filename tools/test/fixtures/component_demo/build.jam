#
# component_demo: a library with a world of its own, whose C bindings
# wit-bindgen generates for wasip2 and wasip3, which the tests of tools/test
# place under libs/component_demo of a scratch superproject.

project /webcpp/component_demo ;

import webcpp ;

alias component_demo : : : : <include>include ;

webcpp.wit-bindings demo-bindings-p2 : wit/world-p2.wit : demo : demo_world : p2 ;
webcpp.wit-bindings demo-bindings-p3 : wit/world-p3.wit : demo : demo_world : p3
  : --async "wasi:http/handler@0.3.0#handle" ;

# The bindings of the target a program is built for, and nothing natively.
alias demo-bindings : demo-bindings-p2 demo-bindings-p3 ;
