# The tests inherit the superproject's configuration and narrow one check.
#
# misc-use-internal-linkage would report every BOOST_AUTO_TEST_CASE of a
# Boost.Test suite: the macro defines a struct per case at namespace scope,
# where Boost.Test's documentation writes every case. AnalyzeTypes off leaves
# those structs alone, and the check still reports a free function or a
# variable that should have internal linkage.
---
InheritParentConfig: true
CheckOptions:
  - key: misc-use-internal-linkage.AnalyzeTypes
    value: 'false'
