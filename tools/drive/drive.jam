#
# The rule of a driven test, which tools/webcpp.jam offers a library's test
# and example Jamfiles as webcpp.drive:
#
#     import webcpp ;
#     webcpp.original <word> + ;
#     webcpp.drive <name> : <sources> + : <requirements> * : <script>
#       : <argument> * : <targets> * ;
#
# webcpp.drive declares the test <name>, which builds a program from the
# sources, as webcpp.serve builds its component, and runs `<original words>
# <script> <arguments> <program>`, with the words of the Jamfile's
# webcpp.original (node, for a script of node's), the script beside the
# Jamfile, and the path of the linked program: its JavaScript on emscripten,
# which a script runs with node, its executable natively. The test passes
# when that command exits with 0: a test that only a script can drive, such
# as one of a peer that a browser or another process meets. tools/drive/drive.py
# runs the command, bounded by 30 s, or the seconds the requirement
# <webcpp-drive-timeout> gives the test: a driver that has not ended by then,
# its program included, is stopped with every process of its group, and the
# test fails naming it; nothing the driver started outlives the test. It is a
# test of
# b2's, which --dump-tests lists and --out-xml records, so that the report
# sees it fail (as a run). It depends on the Jamfile's node-modules, the
# packages its package-lock.json pins, which webcpp.original declares and
# which must come first. It is run again at every build: what the script
# reads is its own business. It runs in an own lane, never in the ordinary
# ones (tools/webcpp.jam's lanes).
#
# This file is loaded as the module webcpp-drive, beside webcpp-component.
# Its rule receives first where its Jamfile is, as tools/webcpp.jam's
# `where` finds it (found): the project, its directory absolute in b2's
# form, that directory relative to the superproject, the Jamfile relative to
# the superproject, and the superproject's directory, absolute.
import errors ;
import feature ;
import generators ;
import modules ;
import os ;
import path ;
import regex ;
import testing ;
import toolset ;
import type ;

# The driven test is a test of b2's, as webcpp.serve's is: DRIVE, a type of
# TEST that testing.make-test declares, which --dump-tests lists and whose
# actions --out-xml records. It is a type of its own, so that no generator of
# RUN's reaches it, and it is made as RUN is: the program, an EXE, is driven
# by drive-and-check into <name>.driven, which testing.expect-success turns
# into <name>.test when it was written.
type.register DRIVEN : driven ;
type.register DRIVE : : TEST ;
generators.register-standard webcpp-drive.drive-and-check : EXE : DRIVEN ;
generators.register-standard testing.expect-success : DRIVEN : DRIVE ;

# A driven test's script, a file beside its Jamfile, bound in the action as
# testing.run binds its input files; the words of the original and the
# arguments, and the test's key, which a message names it by.
feature.feature webcpp-drive-script : : free dependency ;
feature.feature webcpp-drive : : free incidental ;
toolset.flags webcpp-drive.drive-and-check SCRIPT <webcpp-drive-script> ;

# The seconds a driven test's driver may take, its program included, which
# a test's requirements give as <webcpp-drive-timeout>60; 30 without one.
feature.feature webcpp-drive-timeout : : free incidental ;
.default-timeout = 30 ;

if [ os.name ] = NT { .python = python ; } else { .python = python3 ; }

# The runner, beside this file, as an absolute native path: the action runs
# in the directory b2 was started in.
.here = [ path.parent [ path.root [ path.make [ modules.binding $(__name__) ] ] [ path.pwd ] ] ] ;
.runner = [ path.native $(.here)/drive.py ] ;

# webcpp.drive <name> : <sources> + : <requirements> * : <script>
#   : <argument> * ; the test <name>. original is the words of the
# Jamfile's webcpp.original, and only what builds the program for its
# targets alone (webcpp.jam's filter).
rule drive ( found + : name : sources + : requirements * : script : arguments * : original +
    : only * )
{
    local key = $(found[3])/$(name) ;
    .shown.$(key) = "webcpp.drive $(name) in $(found[4])" ;
    .original.$(key) = $(original) ;
    .arguments.$(key) = $(arguments) ;
    if ! [ path.glob $(found[2]) : $(script) ]
    {
        errors.user-error "$(.shown.$(key)): there is no $(script) beside it, which"
            "webcpp.drive runs" ;
    }
    testing.make-test drive : $(sources)
      : $(requirements) $(only) <webcpp-drive-script>$(script) <webcpp-drive>$(key)
        <dependency>node-modules
      : $(name) ;
    $(found[1]).mark-target-as-always $(name) ;
}

# Each of words as one word of the shell, single-quoted: a ' is written '\'',
# and nothing else is special there, $ and ` included.
local rule quoted ( words * )
{
    local result ;
    for local word in $(words)
    {
        local pieces = [ regex.split $(word) "'" ] ;
        result += "'$(pieces:J='\\'')'" ;
    }
    return $(result) ;
}

# The original's words and the arguments of the test, which the action
# places around the script and the program, the test as a message names it,
# and its bound.
rule drive-and-check ( target : source : properties * )
{
    # As testing.capture-output does: the file a dependency feature names is
    # bound before the target is built.
    DEPENDS $(target) : [ on $(target) return $(SCRIPT) ] ;
    local key = [ feature.get-values <webcpp-drive> : $(properties) ] ;
    local timeout = [ feature.get-values <webcpp-drive-timeout> : $(properties) ] ;
    timeout ?= $(.default-timeout) ;
    if $(timeout[2]) || ! [ MATCH "^([0-9]+)$" : $(timeout) ] || $(timeout) = 0
    {
        errors.user-error "$(.shown.$(key)): <webcpp-drive-timeout>$(timeout:J= ) is not a"
            "number of seconds above 0" ;
    }
    ORIGINAL on $(target) = $(.original.$(key)) ;
    ARGUMENTS on $(target) = $(.arguments.$(key)) ;
    PYTHON on $(target) = $(.python) ;
    RUNNER on $(target) = $(.runner) ;
    SHOWN on $(target) = [ quoted $(.shown.$(key)) ] ;
    TIMEOUT on $(target) = $(timeout) ;
}

# The program is the first file of the EXE, its JavaScript on emscripten,
# beside which Emscripten writes its .wasm. What the driver prints is the
# action's output, which b2 shows and --out-xml records; drive.py writes the
# target only once the driver exits with 0.
actions drive-and-check bind SCRIPT
{
    "$(PYTHON)" "$(RUNNER)" --program $(SHOWN) --timeout $(TIMEOUT) --output "$(<)" -- "$(ORIGINAL)" "$(SCRIPT)" "$(ARGUMENTS)" "$(>[1])"
}
